<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground"
    android:orientation="vertical">

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/audit_log_filters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_medicine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/medicines" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_storage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/locations" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_incident"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/conditions" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_device"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/devices" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_user"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/users" />

    </com.google.android.material.chip.ChipGroup>

    <ProgressBar
        android:id="@+id/audit_log_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/audit_log_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/no_audit_logs"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/audit_log_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

</LinearLayout>
