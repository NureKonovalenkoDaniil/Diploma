<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

	<application
		android:name=".MedicationManagementApp"
		android:allowBackup="true"
		android:label="@string/app_name"
		android:supportsRtl="true"
		android:usesCleartextTraffic="true"
		android:theme="@style/Theme.MedicationManagement">
		<activity
			android:name=".LoginActivity"
			android:exported="true">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />

				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity>

		<activity android:name=".MainActivity" android:exported="false" />
		<activity android:name=".MedicineDetailsActivity" android:exported="false" />
		<activity android:name=".RegisterActivity" android:exported="false" />
		<activity android:name=".AddMedicineActivity" android:exported="false" />
		<activity android:name=".EditMedicineActivity" android:exported="false" />
		<activity android:name=".DeviceDetailsActivity" android:exported="false" />
		<activity android:name=".EditDeviceActivity" android:exported="false" />
		<activity android:name=".AddDeviceActivity" android:exported="false" />
		<activity android:name=".ConfirmEmailActivity" android:exported="false" />
		<activity android:name=".ForgotPasswordActivity" android:exported="false" />
		<activity android:name=".ResetPasswordActivity" android:exported="false" />
		<activity android:name=".EditStorageLocationActivity" android:exported="false" />
	</application>

</manifest>
